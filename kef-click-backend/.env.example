# ===== כיף Click — משתני סביבה =====
# העתיקי את הקובץ הזה לקובץ בשם .env ומלאי ערכים אמיתיים.
# אל תעלי את .env ל-GitHub!

# חיבור למסד הנתונים PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kefclick?schema=public"

# מפתח סודי לחתימת JWT — מחרוזת אקראית ארוכה (לפחות 32 תווים)
JWT_SECRET="change-me-to-a-long-random-secret-at-least-32-chars"

# תוקף ה-Token (למשל 8h, 1d)
JWT_EXPIRES_IN="8h"

# פורט מקומי (בענן Render קובע אותו לבד)
PORT=4000

# מאילו כתובות מותר ל-React לפנות לשרת (מופרד בפסיקים). * = כולם
CORS_ORIGIN="http://localhost:5173"

# מפתח סודי שימות המשיח שולח בכל קריאה (api_add_0=key=...)
YEMOT_SECRET="change-me-yemot-secret"

# ===== נתוני הדגמה (Seed) =====
# true = להוסיף מורות, משחקים ומשתתפות לדוגמה
SEED_DEMO=true
# חשבון המנהל שייווצר ב-Seed
SEED_ADMIN_EMAIL="admin@kefclick.local"
SEED_ADMIN_PASSWORD="Admin1234!"
# סיסמה משותפת למנחות הדוגמה
SEED_HOST_PASSWORD="Host1234!"
